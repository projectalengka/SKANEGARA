# ---- Database (PostgreSQL / Supabase) -------------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL=
# Direct (non-pooled) connection used by `prisma migrate` and `prisma db push`.
DIRECT_URL=

# ---- Admin authentication --------------------------------------------------
# Any long random string, e.g. `openssl rand -base64 48`.
# Used to sign the admin session cookie. Minimum 32 characters.
AUTH_SECRET=
# Initial administrator account, created by `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Supabase (opsional) ---------------------------------------------------
# Tidak dibaca oleh aplikasi. Supabase dipakai HANYA sebagai PostgreSQL di sini:
# autentikasi admin ditangani `src/lib/auth.ts`, dan gambar disimpan di basis
# data (lihat `src/lib/media.ts`), bukan di Supabase Storage. Kedua nilai ini
# hanya disiapkan bila nanti memakai fitur Supabase yang lain.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Penyimpanan gambar ----------------------------------------------------
# Tidak ada variabel. Gambar yang diunggah disimpan di dalam basis data yang
# sama dengan isi situs (tabel `MediaAsset`), jadi cukup DATABASE_URL di atas.
# Batasnya 500 MB pada paket gratis Supabase, dipakai bersama seluruh teks —
# halaman Pengaturan di dasbor melaporkan pemakaiannya.
# Rincian: README.md bagian 5 / DEPLOY.md Bagian 7.

# ---- Site ------------------------------------------------------------------
# No trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contoh data (opsional) ------------------------------------------------
# Mengisi bagian yang belum Anda tulis — visi, misi, sejarah, berita, kegiatan,
# galeri, karya — dengan isian bertanda `[CONTOH]`, supaya tata letaknya bisa
# dinilai sebelum tulisan asli sekolah siap.
#
#   `off` / `false` / `0`  → situs menampilkan keadaan kosong yang sebenarnya
#   selain itu             → data contoh ditampilkan ke pengunjung (bawaan)
#
# Bawaannya **menyala**, dan itu aman: data contoh hanya mengisi slot yang masih
# placeholder, jadi ia hilang sendiri begitu Anda menulis isi yang asli. Untuk
# menyembunyikannya sepenuhnya, isi `off` di sini lalu mulai ulang server.
#
# Salah tulis (`On`, `ya`) dilaporkan sebagai tidak dikenali di sidebar dasbor,
# dan yang dipakai adalah bawaan. Lihat `src/data/sample.ts`.
SAMPLE_DATA=
