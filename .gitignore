.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# production
dist/
build/

# environment
# ---------------------------------------------------------------------------
# Semua varian .env diabaikan, bukan hanya yang bernama persis `.env`.
# Daftar nama satu per satu pernah gagal di proyek ini: `.env.lokal` dan
# `.env.produksi` tidak masuk daftar, padahal keduanya berisi kredensial
# Supabase yang sungguhan — dan berkas yang tidak diabaikan tidak
# memunculkan galat apa pun saat ter-commit. Ia hanya diam-diam terunggah.
#
# Pola `*` menutup seluruh varian sekaligus, termasuk nama baru yang belum
# terpikirkan. `.env.example` dikembalikan dengan `!` karena ia memang
# sengaja dibagikan: isinya nama variabel tanpa nilai.
.env
.env.*
!.env.example

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# os
.DS_Store
Thumbs.db

# editor
.vscode/settings.json
.idea/

# qa artefacts
# Tangkapan layar tidak ikut: 177 berkas PNG di `outputs/` berjumlah ±20 MB,
# dan tidak satu pun dipakai saat membangun situs. Skrip probe (.mjs / .cjs)
# tetap ikut karena beberapa di antaranya dirujuk oleh README — yang dikecualikan
# hanya keluarannya, bukan alatnya.
outputs/*.png
outputs/**/*.png
outputs/*-report.json
outputs/tmp/
outputs/*.log

# basis data lokal untuk pengembangan
# Cluster PostgreSQL khusus proyek ini. Isinya data uji, bukan data sekolah,
# dan tidak boleh ikut ter-commit — yayasan berkasnya bisa puluhan MB.
.pgdata/
.pgdata-site/

# catatan kerja lokal
# Berisi catatan pengembangan, bukan kode proyek — tidak ada gunanya bagi
# siapa pun yang meng-clone repositori ini.
.workbuddy-ai/

# panduan kerja pemilik
# Langkah praktis menjalankan, mengelola konten, dan men-deploy. Berguna di
# komputer sendiri, tetapi bukan bagian dari kode situs — jadi tidak ikut ke
# repositori. Panduan teknis untuk pengembang tetap ada di README.md.
PANDUAN.md
DEPLOY.md
